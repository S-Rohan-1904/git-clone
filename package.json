{
    "name": "micro-git",
    "version": "1.0.0",
    "description": "A from-scratch Git implementation in JavaScript (init, hash-object, cat-file, tree/commit objects, clone, and more)",
    "main": "app/main.js",
    "bin": {
        "js-git": "app/main.js"
    },
    "files": [
        "app",
        "README.md"
